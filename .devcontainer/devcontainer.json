{
    "name": "Python with FFmpeg and Streamlit",
    "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bullseye",
    
    "features": {
        // Feature to add FFmpeg to the container.
        "ghcr.io/devcontainers/features/apt-get-install:1": {
            "packages": "ffmpeg"
        }
    },
    
    "customizations": {
        "codespaces": {
            "openFiles": [
                "README.md",
                "main/scenarios/overtaking_cyclist_bidirectional_road.py"
            ]
        },
        "vscode": {
            "settings": {},
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance"
            ]
        }
    },
    
    // Command to install required packages
    "updateContentCommand": "[ -f packages.txt ] && sudo apt update && sudo apt upgrade -y && sudo xargs apt install -y <packages.txt; [ -f requirements.txt ] && pip3 install --user -r requirements.txt; pip3 install --user streamlit; echo '✅ Packages installed and Requirements met'",
    
    "postAttachCommand": {
        "server": "streamlit run main/scenarios/overtaking_cyclist_bidirectional_road.py --server.enableCORS false --server.enableXsrfProtection false"
    },
    
    "portsAttributes": {
        "8501": {
            "label": "Application",
            "onAutoForward": "openPreview"
        }
    },
    
    "forwardPorts": [
        8501
    ]
}